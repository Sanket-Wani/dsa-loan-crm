# Copy to .env — never commit real secrets
DATABASE_URL="postgresql://dsa:dsa_dev_password@localhost:5432/dsa_loan_crm?schema=public"
SESSION_SECRET="change-me-to-a-long-random-string-at-least-32-chars"
NEXT_PUBLIC_APP_NAME="DSA Loan CRM"
# Document storage: local | s3 (S3-compatible; see src/lib/storage.ts and docs/ARCHITECTURE.md)
STORAGE_DRIVER="local"
# Private directory for the local driver (outside public/, git-ignored). Not used on serverless hosts — use s3 there.
STORAGE_DIR="./storage"
UPLOAD_DIR="./uploads"
# S3_* are only required when STORAGE_DRIVER="s3"
# S3_BUCKET=""
# S3_REGION=""
# S3_ENDPOINT=""
# S3_ACCESS_KEY_ID=""
# S3_SECRET_ACCESS_KEY=""
